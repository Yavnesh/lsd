generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for standard credentials auth
  role          String    @default("USER") // USER, ADMIN
  isPremium     Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  
  defaultAvatar    String?
  suggestedAvatars String?  // JSON string
  selectedAvatar   String?
 
  // Gamification & Content Relations
  stat          UserStat?
  activities    UserActivity[]
  quests        UserQuest[]
  trophies      UserTrophy[]
  topicRatings  UserTopicRating[]
  seasonArchives   SeasonArchive[]
  conceptMasteries ConceptMastery[]
  favoriteDecks    UserFavoriteDeck[]
  inventories      UserInventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserStat {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  streak                 Int      @default(0)
  xp                     Int      @default(0)
  level                  String   @default("Curious Mind")
  streakShields          Int      @default(1)
  predictionCorrectCount Int      @default(0)
  
  globalRating           Int      @default(1000)
  peakRating             Int      @default(1000)
  
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Topic {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  emoji            String?
  summary          String?
  content          String?  // JSON formatted blocks
  isPremium        Boolean  @default(false)
  type             String   @default("DAILY") // e.g., DAILY, HUB
  season           String?
  cluster          String?
  dayOfWeek        Int?
  
  difficultyRating Int      @default(1200)
  
  userActivities UserActivity[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserActivity {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId             String?
  topic               Topic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  missionId           String?
  mission             Mission?  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  
  status              String   @default("COMPLETED") // COMPLETED, FAILED
  earnedXp            Int      @default(0)
  selectedOptionIndex Int?
  quizCorrect         Boolean?
  lastAttemptedAt     DateTime @default(now())
  
  completedAt DateTime @default(now())
  
  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@index([missionId])
}

model Quest {
  id          String   @id @default(cuid())
  title       String
  description String
  target      Int      
  rewardXp    Int
  
  userQuests  UserQuest[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserQuest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  completedAt DateTime?
  
  @@unique([userId, questId])
  @@index([userId])
  @@index([questId])
}

model Trophy {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  condition   String?  // Condition to unlock
  
  userTrophies UserTrophy[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserTrophy {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trophyId    String
  trophy      Trophy   @relation(fields: [trophyId], references: [id], onDelete: Cascade)
  
  earnedAt    DateTime @default(now())
  
  @@unique([userId, trophyId])
  @@index([userId])
  @@index([trophyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

model UserTopicRating {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cluster    String
  rating     Int      @default(1000)
  peakRating Int      @default(1000)
  updatedAt  DateTime @updatedAt

  @@unique([userId, cluster])
  @@index([userId])
}

model UserRatingHistory {
  id         String   @id @default(cuid())
  userId     String
  rating     Int
  cluster    String   // "GLOBAL" or category cluster name
  recordedAt DateTime @default(now())

  @@index([userId])
}

model Season {
  id        String          @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  archives  SeasonArchive[]
}

model SeasonArchive {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  finalRating Int
  rankName    String
  xpEarned    Int
  createdAt   DateTime @default(now())
}

model Concept {
  id             String           @id @default(cuid())
  name           String           @unique
  cluster        String
  difficulty     Int              @default(1200)
  masteryEntries ConceptMastery[]
}

model ConceptMastery {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId String
  concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  stars     Float    @default(0.0) // 0.0 to 5.0
  updatedAt DateTime @updatedAt

  @@unique([userId, conceptId])
}

model GhostRun {
  id         String   @id @default(cuid())
  userId     String
  topicId    String
  score      Int
  totalTime  Float
  answersJson String
  rating     Int
  createdAt  DateTime @default(now())
}

model PvpMatch {
  id              String   @id @default(cuid())
  challengerId    String
  opponentId      String
  challengerScore Int
  opponentScore   Int
  challengerTime  Float
  opponentTime    Float
  eloChange       Int
  status          String   // "VICTORY", "DEFEAT", "DRAW"
  createdAt       DateTime @default(now())
}

model UserFavoriteDeck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cluster   String
  createdAt DateTime @default(now())

  @@unique([userId, cluster])
}

model UserInventory {
  id          String   @id @default(cuid())
  userId      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType    String   // "AVATAR", "FRAME", "THEME", "TITLE"
  itemId      String
  equipped    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model World {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  emoji       String
  description String?
  regions     Region[]
  createdAt   DateTime @default(now())
}

model Region {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  worldId     String
  world       World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  missions    Mission[]
  createdAt   DateTime  @default(now())
}

enum DifficultyTier {
  EASY
  MEDIUM
  HARD
}

model Mission {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  sequenceOrder Int
  difficulty    DifficultyTier @default(EASY)
  status        String         @default("DRAFT") // DRAFT, PENDING, APPROVED, PUBLISHED, ARCHIVED
  regionId      String
  region        Region         @relation(fields: [regionId], references: [id], onDelete: Cascade)
  questions     Question[]
  userActivities UserActivity[]
  createdAt     DateTime       @default(now())
}

enum QuestionType {
  MULTIPLE_CHOICE
  SCENARIO_DECISION
  MYTH_FACT
  FILL_CONCEPT
  ORDER_STEPS
}

model Question {
  id           String       @id @default(cuid())
  missionId    String
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  type         QuestionType @default(MULTIPLE_CHOICE)
  text         String
  optionsJson  String
  correctIndex Int
  explanation  String
  createdAt    DateTime     @default(now())
}

model GameSessionCache {
  userId    String   @id
  data      String
  isDirty   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

